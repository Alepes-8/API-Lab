{
  "name": "drink-catalog",
  "version": "1.0.0",
  "description": "An API to catalog and rate different drinks as well as allow the user to set notes to drinks in order to later improvments",
  "main": "index.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start": "node src/app.js",
    "dev": "docker compose --env-file .env.dev -f docker-compose.dev.yml up ",
    "dev:build": "docker compose --env-file .env.dev -f docker-compose.dev.yml up --build",
    "dev:clean": "docker compose --env-file .env.dev -f docker-compose.dev.yml down -v",
    "prod:deploy": "docker compose --env-file .env.prod up -d",
    "prod:clean": "docker compose --env-file .env.prod -f docker-compose.prod.yml down -v",
    "staging:deploy": "docker compose --env-file .env.staging up -d",
    "staging:clean": "docker compose --env-file .env.staging -f docker-compose.staging.yml down -v"
  },
  "jest": {
    "moduleNameMapper": {
      "^../authentication/authMiddleware\\.js$": "<rootDir>/tests/__mocks__/authMiddleware.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.3",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-parser": "^10.0.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "mockingoose": "^2.16.2",
    "nodemon": "^3.1.10",
    "sonarqube-scanner": "^4.3.2",
    "supertest": "^6.3.3"
  }
}
